{
  "name": "eres-remotion-showreel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx EresShowreel out/eres-showreel.mp4 --codec=h264 --crf=16 --concurrency=4",
