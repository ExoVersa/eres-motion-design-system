    "assets:search": "tsx scripts/search-assets.ts",
    "assets:download": "tsx scripts/download-asset.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/motion-blur": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
